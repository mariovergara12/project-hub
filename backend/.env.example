# Local development values only. Copy to backend/.env; never commit the real file.
APP_NAME=Project Hub API
POSTGRES_USER=project_hub
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=project_hub
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://project_hub:local_dev_only@localhost:5432/project_hub
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
# Project origin for verifying Supabase access tokens (no API key needed).
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# Optional: dedicated EMPTY database, never the application database.
# TEST_DATABASE_URL=postgresql+psycopg://project_hub:local_dev_only@localhost:5432/project_hub_test
