# Copy to backend/.env.supabase. The real file is ignored by Git.
# Copy your session-pooler host and username from Supabase's Connect dialog.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF@POOLER_HOST:5432/postgres?sslmode=require
# Store the password separately so URL-special characters do not need encoding.
# Single quotes preserve characters such as # and $. Escape ' as \' if needed.
DATABASE_PASSWORD='[YOUR-PASSWORD]'
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=0
SUPABASE_URL=https://PROJECT_REF.supabase.co
